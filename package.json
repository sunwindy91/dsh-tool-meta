{
  "name": "@sunwindy/dsh-tool-meta",
  "version": "0.5.0",
  "description": "自进化元认知引擎：观测 tools/result 成败 → 反思 → 自动沉淀 SKILL + 效果账本 → 滋养后续会话；并带「不可逆动作」前置闸门（删除 / 对外动作）与审计流水。零依赖、零私有格式。",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "skill",
    "self-evolving",
    "metacognition",
    "audit",
    "guardrail",
    "governance"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunwindy91/dsh-tool-meta.git"
  },
  "homepage": "https://github.com/sunwindy91/dsh-tool-meta#readme",
  "bugs": {
    "url": "https://github.com/sunwindy91/dsh-tool-meta/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "docs/**/*.md"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  }
}
